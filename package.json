{
  "name": "purchase-management-collection",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Purchase Management Collection — local-first purchase records, withdrawal/return deadline tracking with RFC 5545 reminders, and public carrier parcel links for EU consumers.",
  "scripts": {
    "start": "tsx server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs && node scripts/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
